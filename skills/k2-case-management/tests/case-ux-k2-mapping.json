{
  "schema_version": 1,
  "application": {
    "name": "TST.Reusable Case UX",
    "rootCategoryPath": "K2 Skills\\TST.Case UX Test",
    "solutionCode": "TST",
    "theme": "Lithium",
    "styleProfile": "Test Style"
  },
  "homepage": {
    "page": "operations-dashboard",
    "implementation": "native-smartforms",
    "navigation": {
      "viewName": "TST.Application Navigation",
      "smartObject": "TST_ApplicationNavigation",
      "properties": ["NavigationCode","SectionLabel","Label","IconToken","TargetFormName","SortOrder","IsActive","ConfigurationVersion"]
    },
    "commandPalette": {
      "viewName": "TST.Command Palette",
      "smartObject": "TST_CommandSuggestion",
      "properties": ["SuggestionCode","Kind","Title","Subtitle","IconToken","TargetUrl","SortOrder","IsActive","ConfigurationVersion"],
      "controlName": "Northstar Command Palette",
      "controlType": "northstar-command-palette",
      "listMethod": "List",
      "listDataProperty": "Suggestions",
      "propertiesMap": {
        "Value": "",
        "Suggestions": "[]",
        "SearchUrlTemplate": "/Runtime/Runtime/Form/TST.All%20Cases?q={query}",
        "Placeholder": "Search cases, work and reports",
        "Width": "100%",
        "Height": "48px",
        "TagName": "northstar-command-palette",
        "RuntimeScriptFileNames": "northstar-command-runtime.js",
        "DesigntimeScriptFileNames": "northstar-command-designtime.js",
        "RuntimeStyleFileNames": "northstar-command-runtime.css",
        "DesigntimeStyleFileNames": "northstar-command-designtime.css",
        "Icon": "northstar-command-icon.svg"
      }
    }
  },
  "dashboard": {
    "page": "operations-dashboard",
    "formName": "TST.Quality Operations",
    "summary": {
      "viewName": "TST.Operations KPIs",
      "smartObject": "TST_DashboardSummary",
      "components": [
        { "id": "open-cases", "property": "OpenCaseCount", "label": "Open cases" },
        { "id": "sla-at-risk", "property": "SLAAtRiskCount", "tone": "warning" }
      ]
    },
    "charts": [
      {
        "component": "cases-by-stage",
        "viewName": "TST.Cases by Stage",
        "smartObject": "TST_CasesByStage",
        "categoryProperty": "StageLabel",
        "valueProperty": "CaseCount",
        "title": "Cases by stage"
      }
    ],
    "queues": [
      {
        "component": "urgent-work",
        "viewName": "TST.Urgent Work",
        "smartObject": "TST_UrgentWork",
        "properties": ["CaseNumber", "Title", "SLAStatus"]
      }
    ]
  },
  "workspace": {
    "viewName": "TST.Case Workspace",
    "shellFormName": "TST.Case Management",
    "analyticsTab": "Analytics",
    "lifecycleComponent": "case-lifecycle",
    "currentStageProperty": "CurrentStageCode",
    "stages": [
      { "code": "CAPTURE", "label": "Capture" },
      { "code": "INVESTIGATE", "label": "Investigate" },
      { "code": "CLOSE", "label": "Close" }
    ]
  },
  "runtimeBaseUrl": "https://k2.example.test/Runtime"
}
