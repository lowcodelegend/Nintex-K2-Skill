    {"id": "Suggestions", "friendlyname": "Governed suggestions", "type": "listdata", "initialvalue": "[]", "refreshdisplay": true, "changesdisplay": true},
    {"id": "SearchUrlTemplate", "friendlyname": "All Cases search URL template", "type": "string", "initialvalue": "/Runtime/Runtime/Form/All%20Cases?q={query}", "changesdisplay": false},
    {"id": "Placeholder", "friendlyname": "Search placeholder", "type": "string", "initialvalue": "Search cases, work and reports", "changesdisplay": true},
    {"id": "Width", "friendlyname": "Width", "type": "string", "initialvalue": "100%", "changesdisplay": true},
    {"id": "Height", "friendlyname": "Height", "type": "string", "initialvalue": "48px", "changesdisplay": true},
    {"id": "IsReadOnly", "friendlyname": "Read only", "type": "bool", "initialvalue": false, "changesdisplay": true}
  ]
}
