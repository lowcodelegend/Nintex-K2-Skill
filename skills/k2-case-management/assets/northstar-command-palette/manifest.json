{
  "displayName": "Northstar Command Palette",
  "tagName": "northstar-command-palette",
  "description": "Accessible Northstar Ctrl/Cmd+K command palette over one governed K2 SmartObject projection.",
  "icon": "northstar-command-icon.svg",
  "designtimeScriptFileNames": ["northstar-command-designtime.js"],
  "runtimeScriptFileNames": ["northstar-command-runtime.js"],
  "designtimeStyleFileNames": ["northstar-command-designtime.css"],
  "runtimeStyleFileNames": ["northstar-command-runtime.css"],
  "datatypes": ["Text"],
  "valuePropertyID": "Value",
  "supports": ["Value", "Width", "Height", "IsVisible", "IsEnabled", "IsReadOnly", "TabIndex", "ControlExpression", "DataBinding"],
  "events": [
    {"id": "Navigate", "displayname": "Navigate"},
    {"id": "OpenAssistant", "displayname": "Open case assistant"}
  ],
  "properties": [
    {"id": "Value", "friendlyname": "Selected target URL", "type": "string", "initialvalue": "", "changesdisplay": false},
    {"id": "Suggestions", "friendlyname": "Governed suggestions", "type": "listdata", "initialvalue": "[]", "refreshdisplay": true, "changesdisplay": true},
    {"id": "SearchUrlTemplate", "friendlyname": "All Cases search URL template", "type": "string", "initialvalue": "/Runtime/Runtime/Form/All%20Cases?q={query}", "changesdisplay": false},
    {"id": "Placeholder", "friendlyname": "Search placeholder", "type": "string", "initialvalue": "Search cases, work and reports", "changesdisplay": true},
    {"id": "AssistantEnabled", "friendlyname": "Enable case assistant", "type": "bool", "initialvalue": false, "changesdisplay": true},
    {"id": "AssistantExperience", "friendlyname": "Assistant experience", "type": "string", "initialvalue": "embedded-widget", "changesdisplay": true},
    {"id": "AssistantLabel", "friendlyname": "Case assistant label", "type": "string", "initialvalue": "Ask Case Assistant", "changesdisplay": true},
    {"id": "AssistantDescription", "friendlyname": "Case assistant description", "type": "string", "initialvalue": "Ask questions and take supported case actions", "changesdisplay": true},
    {"id": "LangflowHostUrl", "friendlyname": "Langflow host URL", "type": "string", "initialvalue": "", "changesdisplay": false},
    {"id": "LangflowFlowId", "friendlyname": "Langflow flow ID", "type": "string", "initialvalue": "", "changesdisplay": false},
    {"id": "LangflowScriptUrl", "friendlyname": "Pinned Langflow embedded-chat script URL", "type": "string", "initialvalue": "https://cdn.jsdelivr.net/gh/langflow-ai/langflow-embedded-chat@v1.0.8/dist/build/static/js/bundle.min.js", "changesdisplay": false},
    {"id": "LangflowAuthenticationMode", "friendlyname": "Langflow server authentication mode", "type": "string", "initialvalue": "server-proxy", "changesdisplay": false},
    {"id": "LangflowWindowTitle", "friendlyname": "Langflow window title", "type": "string", "initialvalue": "Case Assistant", "changesdisplay": true},
    {"id": "LangflowChatPosition", "friendlyname": "Langflow chat position", "type": "string", "initialvalue": "bottom-right", "changesdisplay": true},
    {"id": "LangflowWidth", "friendlyname": "Langflow window width", "type": "string", "initialvalue": "420", "changesdisplay": true},
    {"id": "LangflowHeight", "friendlyname": "Langflow window height", "type": "string", "initialvalue": "640", "changesdisplay": true},
    {"id": "LangflowFileComponentId", "friendlyname": "Langflow Read File component ID", "type": "string", "initialvalue": "", "changesdisplay": false},
    {"id": "LangflowChatInputComponentId", "friendlyname": "Langflow Chat Input component ID", "type": "string", "initialvalue": "", "changesdisplay": false},
    {"id": "LangflowAllowedFileTypes", "friendlyname": "Allowed assistant file types", "type": "string", "initialvalue": ".pdf,.txt,.md,.csv,.docx,.xlsx,.png,.jpg,.jpeg,.gif,.bmp,.webp", "changesdisplay": false},
    {"id": "LangflowMaxFileSizeMb", "friendlyname": "Maximum assistant file size MB", "type": "string", "initialvalue": "25", "changesdisplay": false},
    {"id": "Width", "friendlyname": "Width", "type": "string", "initialvalue": "100%", "changesdisplay": true},
    {"id": "Height", "friendlyname": "Height", "type": "string", "initialvalue": "48px", "changesdisplay": true},
    {"id": "IsReadOnly", "friendlyname": "Read only", "type": "bool", "initialvalue": false, "changesdisplay": true}
  ]
}
