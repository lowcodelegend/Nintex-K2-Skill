    {
      "id": "IsReadOnly",
      "friendlyname": "Read only",
      "type": "bool",
      "initialvalue": false,
      "changesdisplay": true
    }
  ],
  "methods": [
    {"id": "refresh", "displayname": "Refresh", "returntype": "None", "parameters": []},
    {"id": "openSearch", "displayname": "Open Search", "returntype": "None", "parameters": []},
    {"id": "focusMain", "displayname": "Focus Main Content", "returntype": "None", "parameters": []}
  ]
