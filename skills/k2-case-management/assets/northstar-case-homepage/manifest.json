    {
      "id": "Width",
      "friendlyname": "Width",
      "type": "string",
      "inputlength": "50",
      "initialvalue": "100%",
      "changesdisplay": true
    },
    {
      "id": "Height",
      "friendlyname": "Height",
      "type": "string",
      "inputlength": "50",
      "initialvalue": "1000px",
      "changesdisplay": true
