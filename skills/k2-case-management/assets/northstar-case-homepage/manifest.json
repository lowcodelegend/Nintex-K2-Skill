      "initialvalue": "[{\"kind\":\"metric\",\"id\":\"open-cases\",\"label\":\"Open cases\",\"value\":\"128\",\"delta\":\"Down 8.6% vs last month\",\"icon\":\"▤\",\"tone\":\"positive\"}]"
    },
    {
      "id": "Value",
      "friendlyname": "Command value",
      "type": "string",
      "inputlength": "255",
      "initialvalue": "",
      "changesdisplay": true
    },
    {
      "id": "ApplicationName",
      "friendlyname": "Application name",
      "type": "string",
      "inputlength": "80",
      "initialvalue": "Northstar",
      "changesdisplay": true
    },
    {
      "id": "ApplicationSubtitle",
      "friendlyname": "Application subtitle",
      "type": "string",
      "inputlength": "120",
      "initialvalue": "Quality operations",
      "changesdisplay": true
    },
    {
      "id": "UserName",
      "friendlyname": "User name",
      "type": "string",
      "inputlength": "120",
      "initialvalue": "Alex Morgan",
      "changesdisplay": true
    },
    {
      "id": "UserRole",
      "friendlyname": "User role",
      "type": "string",
      "inputlength": "120",
      "initialvalue": "Quality manager",
      "changesdisplay": true
    },
    {
      "id": "Greeting",
      "friendlyname": "Greeting",
      "type": "string",
      "inputlength": "160",
      "initialvalue": "Good morning, Alex",
