    {"id": "Changed", "displayname": "Changed"}
  ],
  "properties": [
    {"id": "Value", "friendlyname": "Value", "type": "string", "initialvalue": "", "changesdisplay": true},
    {"id": "Width", "friendlyname": "Width", "type": "string", "initialvalue": "100%", "changesdisplay": true},
    {"id": "Height", "friendlyname": "Height", "type": "string", "initialvalue": "64px", "changesdisplay": true},
    {"id": "IsReadOnly", "friendlyname": "Read only", "type": "bool", "initialvalue": false, "changesdisplay": true}
  ]
}
