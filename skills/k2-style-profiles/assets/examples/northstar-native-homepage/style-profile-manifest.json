        "source": "northstar-config.js",
        "target": "northstar-config.v15.js"
      },
      {
        "type": "js",
        "source": "northstar-shell.js",
        "target": "northstar-shell.v15.js"
      }
    ]
  },
  "hosting": {
    "enabled": true,
    "configureIis": true,
    "siteName": "K2",
    "applicationPath": "K2/",
    "virtualPath": "/NorthstarAssets",
    "physicalPath": "C:\\inetpub\\northstar-assets",
