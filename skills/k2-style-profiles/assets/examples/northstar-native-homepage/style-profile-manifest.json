{
  "schemaVersion": 1,
  "name": "Northstar native homepage Style Profile",
  "k2": {
    "host": "localhost",
    "port": 5555,
    "integrated": true,
    "securityLabel": "K2"
  },
  "styleProfile": {
    "systemName": "Northstar Native Homepage",
    "displayName": "Northstar Native Homepage",
    "description": "Runtime-only Northstar shell for native K2 navigation, guided initiation, command palette, KPI, chart, and queue Views.",
