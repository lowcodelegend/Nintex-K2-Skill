        ],
        "viewTitles": {
          "SNC.Urgent Work": "Urgent cases needing attention"
        },
        "tabs": [
          {
            "name": "My Tasks",
            "worklist": {
              "rows": 20,
              "refreshIntervalSeconds": 120,
              "showToolbar": true,
              "showFilter": true,
              "showSearch": false,
              "enableSearch": true,
              "height": "445px",
              "openTaskInNewWindow": true,
              "actions": [
